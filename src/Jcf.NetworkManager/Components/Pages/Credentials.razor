@page "/credentials"
@attribute [Authorize]
@inject CredentialVault Vault
@inject AuthenticationStateProvider Authentication

<h1>Device credential profiles</h1>
<p class="lede">Create API credentials once and select them during AP or switch onboarding. Profiles are encrypted using the server's persistent ASP.NET Core Data Protection key ring.</p>
<div class="actionbar">
    <a class="wizard-choice-link" href="/onboarding?type=ap">Onboard access points</a>
    <a class="wizard-choice-link" href="/onboarding?type=switch">Onboard CX switches</a>
</div>
@if(!string.IsNullOrWhiteSpace(message)){<div role="status" class="banner @(error?"warn":"")">@message</div>}
<section class="panel">
    <h2>Saved credential profiles</h2>
    @if(profiles.Count==0){<p class="muted">No profiles saved. Create an encrypted profile below before onboarding new real equipment.</p>}
    else
    {
        <table>
            <thead><tr><th>Profile</th><th>Storage</th><th>Devices using</th><th>Last updated</th>@if(isOperator){<th>Manage</th>}</tr></thead>
            <tbody>
            @foreach(var p in profiles)
            {
                <tr>
                    <td>@p.Reference</td><td>@p.Source</td><td>@p.DevicesUsing</td>
                    <td>@(p.UpdatedUtc?.ToString("yyyy-MM-dd HH:mm")+" UTC"??"Not saved")</td>
                    @if(isOperator)
                    {
                        <td>
                            <button class="smallbutton secondary" @onclick="()=>Pick(p.Reference)">Rotate</button>
                            @if(p.DevicesUsing==0 && p.UpdatedUtc.HasValue)
                            {
                                <button class="smallbutton secondary" @onclick="()=>AskDelete(p.Reference)">Remove</button>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    }
</section>
@if(isOperator)
{
    <section class="panel">
        <h2>Create or rotate a profile</h2>
        <p class="muted">Use an Aruba device-management username, not a JCF application account. Rotating a shared profile updates all devices that reference it.</p>
        <div class="formgrid">
            <label>Reference (letters, digits, underscores)<input @bind="reference" maxlength="40" placeholder="HQ_INSTANT" /></label>
            <label>Description<input @bind="description" maxlength="200" placeholder="HQ AP management API" /></label>
            <label>Username<input @bind="username" maxlength="128" autocomplete="off" /></label>
            <label>Password<input @bind="password" type="password" maxlength="256" autocomplete="new-password" /></label>
        </div>
        <div class="actionbar">
            <button disabled="@busy" @onclick="SaveAsync">Save encrypted credentials</button>
            <button disabled="@busy" class="secondary" @onclick="Clear">Clear form</button>
        </div>
        @if(!string.IsNullOrEmpty(confirmDelete))
        {
            <div class="banner warn">
                Delete @confirmDelete? This cannot be undone and applies only if no registered real equipment references it.
                <button class="danger" @onclick="DeleteAsync">Confirm deletion</button>
                <button class="secondary" @onclick="()=>confirmDelete=""">Cancel</button>
            </div>
        }
    </section>
}
else {<div class="banner">Viewing credentials requires authentication. Creating or changing profiles requires an operator role.</div>}

@code {
    private bool isOperator,busy,error;
    private string reference="",username="",password="",description="",message="",confirmDelete="";
    private List<CredentialVault.CredentialView> profiles=[];
    protected override async Task OnInitializedAsync()
    {
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        isOperator=JcfRoles.IsOperator(user);
        await Refresh();
    }
    private Task Refresh()=>LoadAsync();
    private async Task LoadAsync(){profiles=await Vault.ListAsync();}
    private async Task<string> Actor()
    {
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        JcfRoles.RequireOperator(user);
        return user.Identity?.Name??throw new UnauthorizedAccessException();
    }
    private void Pick(string profile){reference=profile;password="";username="";message="Enter replacement username and password to rotate "+profile;error=false;}
    private void Clear(){reference="";username="";password="";description="";confirmDelete="";message="";error=false;}
    private void AskDelete(string profile){confirmDelete=profile;message="";error=false;}
    private async Task SaveAsync()
    {
        busy=true;
        try
        {
            await Vault.SetAsync(reference,username,password,description,await Actor());
            username="";password="";description="";
            await Refresh();
            message="Encrypted profile saved. Choose it in the discovery and onboarding wizard.";error=false;
        }
        catch(Exception ex){message=ex.Message;error=true;}
        finally{password="";busy=false;}
    }
    private async Task DeleteAsync()
    {
        busy=true;
        try
        {
            var profile=confirmDelete;
            await Vault.DeleteAsync(profile,await Actor());
            confirmDelete="";await Refresh();
            message="Removed unused profile "+profile;error=false;
        }catch(Exception ex){message=ex.Message;error=true;}
        finally{busy=false;}
    }
}
